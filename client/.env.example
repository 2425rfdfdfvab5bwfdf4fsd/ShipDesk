# ── CLERK (Frontend) ───────────────────────────────────────────────────────────
# From Clerk dashboard → API Keys (starts with pk_live_ or pk_test_)
VITE_CLERK_PUBLISHABLE_KEY=

# ── BACKEND URL ────────────────────────────────────────────────────────────────
# Your Railway backend URL — NO trailing slash, NO /api suffix
# Example: https://shipdesk-server.up.railway.app
# Leave empty for local dev (Vite proxy handles /api/* automatically)
VITE_API_BASE_URL=
